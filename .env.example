# Core app
DATABASE_URL=postgresql://meeting:meeting@localhost:5432/meeting
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
MEETING_ALLOWED_EMAIL_DOMAINS=

# Unattended Teams browser bot
# Must point to the running Meeting web app and use the same NEXTAUTH_SECRET above.
MEETING_BOT_BASE_URL=http://localhost:3000
MEETING_BOT_RUNNER_TOKEN=replace-with-a-separate-long-random-token
MEETING_BOT_RUNNER_ID=
MEETING_BOT_TEAMS_DISPLAY_NAME=Meeting STT Assistant
MEETING_BOT_STT_EMAIL=

# Runner behavior
MEETING_BOT_HEADLESS=false
MEETING_BOT_POLL_MS=3000
MEETING_BOT_SCHEDULE_POLL_MS=15000
MEETING_BOT_SCHEDULE_LATE_GRACE_MS=600000
MEETING_BOT_CALENDAR_LATE_GRACE_MS=600000
MEETING_BOT_MAX_CONCURRENCY=2
MEETING_BOT_LOBBY_TIMEOUT_MS=900000
MEETING_BOT_RECONNECT_TIMEOUT_MS=120000
MEETING_BOT_REJOIN_WINDOW_MS=120000
MEETING_BOT_REJOIN_ATTEMPT_MS=30000
MEETING_BOT_MAX_CONTINUATIONS=2
MEETING_BOT_AUDIO_INITIAL_SIGNAL_MS=60000
MEETING_BOT_AUDIO_SILENCE_MS=180000
MEETING_BOT_START_GRACE_MS=60000
MEETING_BOT_LEASE_TIMEOUT_MS=120000
MEETING_BOT_ALONE_TIMEOUT_MS=300000
MEETING_BOT_MAX_DURATION_MS=14400000
MEETING_BOT_PROCESSING_POLL_MS=5000
MEETING_BOT_PROCESSING_TIMEOUT_MIN_MS=600000
MEETING_BOT_PROCESSING_TIMEOUT_MAX_MS=5400000
MEETING_BOT_PROCESSING_TIMEOUT_MS=2700000
MEETING_PROCESSING_STALE_MS=7200000

# Optional browser override
MEETING_BOT_BROWSER_CHANNEL=
MEETING_BOT_BROWSER_EXECUTABLE=

# Optional Microsoft Graph Outlook calendar sync.
# Leave all values blank to use only the app's internal schedules.
# The Graph app uses application permissions (background/client-credentials).
MEETING_BOT_GRAPH_TENANT_ID=
MEETING_BOT_GRAPH_CLIENT_ID=
MEETING_BOT_GRAPH_CLIENT_SECRET=
# Dedicated shared mailbox invited to meetings, e.g. meetingbot@company.com.
# USER_ID may be the mailbox email/UPN or its Entra object id.
MEETING_BOT_GRAPH_USER_ID=
# Required only when USER_ID is an opaque GUID. Otherwise derived from USER_ID.
MEETING_BOT_GRAPH_BOT_EMAIL=
# Comma-separated organizer domains allowed to trigger auto-join.
# Defaults to the bot mailbox domain.
MEETING_BOT_GRAPH_ALLOWED_ORGANIZER_DOMAINS=
# Polling/snapshot window. Legacy MEETING_BOT_CALENDAR_POLL_MS is still accepted as a fallback.
MEETING_BOT_GRAPH_SYNC_MS=60000
MEETING_BOT_GRAPH_LOOKBACK_MIN=30
MEETING_BOT_GRAPH_LOOKAHEAD_HOURS=48
